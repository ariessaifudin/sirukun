{
  "name": "sirukun/aplikasi-rt-rw",
  "description": "SIRUKUN - Sistem Informasi RT/RW Terpadu",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "barryvdh/laravel-dompdf": "^3.1",
    "bacon/bacon-qr-code": "^3.0",
    "phpoffice/phpspreadsheet": "^5.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "platform": {"php": "8.2.12"}},
  "minimum-stability": "stable", "prefer-stable": true
}
